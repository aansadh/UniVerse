    {
      "id": "RrE96ERUPwD_bkMO2ZbNv",
      "type": "text",
      "x": 2653.7683427386605,
      "y": -3782.1900138964825,
      "width": 1138.967529296875,
      "height": 1987.1999999999998,
      "angle": 0,
